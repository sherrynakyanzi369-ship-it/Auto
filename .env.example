# ─────────────────────────────────────────────────────────────────────
# AutoAssist API environment variables
# Copy the values you need into your Vercel project:
#   Vercel dashboard → Project → Settings → Environment Variables
# or with the CLI:  vercel env add DATABASE_URL production
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL (Supabase / Neon). Use the *pooled* connection string.
# Supabase: Project → Settings → Database → Connection string → URI (Connection pooling)
# Neon:     Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SSLMODE=require

# Redis cache — Upstash REST (recommended on Vercel serverless)
# Upstash: console → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis cache — alternative standard Redis protocol URL (local/dev or VPS)
REDIS_URL=
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_HOURS=720

# CORS: comma separated origins, or * for all
CORS_ORIGINS=*

# Seed the mechanics/parts catalog on first boot
SEED_ON_START=true
